{
  "manifest_version": 3,
  "name": "AI Wars Bridge",
  "version": "0.1.1",
  "description": "Lets AI Wars play matches through chatbot web tabs (ChatGPT, Claude, Gemini) with no API key. Opens the tab, sends the turn, reads the reply back.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://aiwars.lol/*",
        "*://*.aiwars.lol/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "handoff.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
